-				    (size_t)w * 4);
+		/*
+		 * The presented display is fLogicalW x fLogicalH (the iPhone X geometry UIKit
+		 * lays out for); the panel is fWidth x fHeight. Scale the logical rectangle onto
+		 * the panel instead of cropping it, so the status bar and the home indicator
+		 * stay on screen (identity when sweetfb_native=1). Idea: qfl152/ios-fajita 6bb635c.
+		 */
+		int32_t pw = (int32_t)(((int64_t)w * fWidth) / fLogicalW);
+		int32_t ph = (int32_t)(((int64_t)h * fHeight) / fLogicalH);
+		int32_t px = (int32_t)(((int64_t)dx * fWidth) / fLogicalW);
+		int32_t py = (int32_t)(((int64_t)dy * fHeight) / fLogicalH);
+		if (pw > (int32_t)fWidth - px) {
+			pw = (int32_t)fWidth - px;
+		}
+		if (ph > (int32_t)fHeight - py) {
+			ph = (int32_t)fHeight - py;
+		}
+		if (src != 0 && bpe == 4 && pw > 0 && ph > 0) {
+			/* Nearest neighbour; the source is a RAM surface and this runs at sweetfb_hz. */
+			for (int32_t y = 0; y < ph; y++) {
+				int32_t ys = sy + (int32_t)(((int64_t)y * h) / ph);
+				uint32_t *drow = (uint32_t *)(fPixels + (uint64_t)(py + y) * fRowBytes) + px;
+				const uint32_t *srow = (const uint32_t *)(src + s->offset +
+				    (uint64_t)ys * s->bytesPerRow) + sx;
+				for (int32_t x = 0; x < pw; x++) {
+					drow[x] = srow[(int32_t)(((int64_t)x * w) / pw)];
+				}
 			}
 		}
 		s->release();
