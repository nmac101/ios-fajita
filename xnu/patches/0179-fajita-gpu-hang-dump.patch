+/* hang dump (a6xx.xml dword offsets) */
+#define A6XX_RBBM_STATUS1       0x0211u
+#define A6XX_RBBM_STATUS2       0x0212u
+#define A6XX_RBBM_STATUS3       0x0213u
+#define A6XX_CP_IB1_BASE        0x0928u   /* 64-bit: lo, hi */
+#define A6XX_CP_IB1_REM_SIZE    0x092au
+#define A6XX_CP_IB2_BASE        0x092bu
+#define A6XX_CP_IB2_REM_SIZE    0x092du
+#define A6XX_CP_SQE_STAT_ADDR   0x0908u
+#define A6XX_CP_SQE_STAT_DATA   0x0909u
