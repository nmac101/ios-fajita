+/*
+ * A submission whose fence never lands: log where the CP stopped and whether the SMMU
+ * faulted, once per fence. Only reads, except the SQE stat index (Linux's a6xx crash dump
+ * does the same); nothing is reset or cleared, so a second dump shows the same state.
+ */
+void
+sweet_gpu_hang_dump(const char *why)
+{
+	static uint32_t dumped;
+	vm_offset_t c = gpu_core;
+
+	if (!gpu_live || c == 0 || gpu_blob == 0) {
+		printf("SWEET GPU HANG (%s): GPU not live, nothing to read\n", why);
+		return;
+	}
+	if (dumped == gpu_cp_seq) {
+		return;
+	}
+	dumped = gpu_cp_seq;
+	printf("SWEET GPU HANG (%s): fence at %u, last submitted %u; ring rptr %u wptr %u\n", why,
+	    *(volatile uint32_t *)(gpu_blob + GPU_CP_SCRATCH + GPU_CP_SCRATCH_FENCE), gpu_cp_seq,
+	    gpu_cp_rd(c, A6XX_CP_RB_RPTR), gpu_cp_wptr);
+	printf("SWEET GPU HANG: rbbm_status %#x %#x %#x %#x rbbm_int0 %#x\n",
+	    gpu_cp_rd(c, A6XX_RBBM_STATUS), gpu_cp_rd(c, A6XX_RBBM_STATUS1),
+	    gpu_cp_rd(c, A6XX_RBBM_STATUS2), gpu_cp_rd(c, A6XX_RBBM_STATUS3),
+	    gpu_cp_rd(c, A6XX_RBBM_INT_0_STATUS));
+	printf("SWEET GPU HANG: cp_status1 %#x hw_fault %#x cp_irq %#x protect %#x\n",
+	    gpu_cp_rd(c, A6XX_CP_STATUS_1), gpu_cp_rd(c, A6XX_CP_HW_FAULT),
+	    gpu_cp_rd(c, A6XX_CP_INTERRUPT_STATUS), gpu_cp_rd(c, A6XX_CP_PROTECT_STATUS));
+	printf("SWEET GPU HANG: ib1 %#llx rem %u dwords, ib2 %#llx rem %u dwords\n",
+	    (uint64_t)gpu_cp_rd(c, A6XX_CP_IB1_BASE + 1) << 32 | gpu_cp_rd(c, A6XX_CP_IB1_BASE),
+	    gpu_cp_rd(c, A6XX_CP_IB1_REM_SIZE),
+	    (uint64_t)gpu_cp_rd(c, A6XX_CP_IB2_BASE + 1) << 32 | gpu_cp_rd(c, A6XX_CP_IB2_BASE),
+	    gpu_cp_rd(c, A6XX_CP_IB2_REM_SIZE));
+	uint32_t sqe[8];
+	gpu_cp_wr(c, A6XX_CP_SQE_STAT_ADDR, 0);
+	for (unsigned i = 0; i < 8; i++) {
+		sqe[i] = gpu_cp_rd(c, A6XX_CP_SQE_STAT_DATA);
+	}
+	printf("SWEET GPU HANG: sqe stat %#x %#x %#x %#x %#x %#x %#x %#x\n",
+	    sqe[0], sqe[1], sqe[2], sqe[3], sqe[4], sqe[5], sqe[6], sqe[7]);
+	if (gpu_smmu == 0) {
+		gpu_smmu = ml_io_map(GPU_SMMU, 0x10000);
+	}
+	if (gpu_smmu == 0) {
+		printf("SWEET GPU HANG: smmu not mapped\n");
+		return;
+	}
+	printf("SWEET GPU HANG: smmu sGFSR %#x\n", gpu_rd_quiet(gpu_smmu, GPU_SMMU_SGFSR));
+	for (unsigned cb = 0; cb < 2; cb++) {
+		vm_offset_t b = gpu_smmu + GPU_SMMU_CB(cb);
+		printf("SWEET GPU HANG: smmu cb%u fsr %#x far %#llx fsynr0 %#x fsynr1 %#x\n", cb,
+		    gpu_rd_quiet(b, GPU_SMMU_CB_FSR),
+		    (uint64_t)gpu_rd_quiet(b, GPU_SMMU_CB_FAR + 4) << 32 | gpu_rd_quiet(b, GPU_SMMU_CB_FAR),
+		    gpu_rd_quiet(b, GPU_SMMU_CB_FSYNR0), gpu_rd_quiet(b, GPU_SMMU_CB_FSYNR1));
+	}
+}
